{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WSL: NLP demo LLM + memory",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_pipeline.py",
      "args": [
        "--llm",
        "--llm-model",
        "llama3.2:1b",
        "--llm-timeout",
        "60",
        "--memory-db",
        "${workspaceFolder}/artifacts/runtime/command_memory.sqlite3"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "WSL: NLP demo DistilBERT + LLM + memory",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_pipeline.py",
      "args": [
        "--model",
        "${workspaceFolder}/models/distilbert-robot-commander-3intents",
        "--llm",
        "--llm-model",
        "llama3.2:1b",
        "--llm-timeout",
        "60",
        "--memory-db",
        "${workspaceFolder}/artifacts/runtime/command_memory.sqlite3"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    }
  ]
}
