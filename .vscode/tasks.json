{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NLP: run all tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q",
        "--basetemp",
        "${workspaceFolder}/.pytest-tmp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
